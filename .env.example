# Backend REST API Base URL
# Development: http://localhost:8080
# Production:  https://smart-bus-tracking-backend.onrender.com
VITE_API_BASE_URL=http://localhost:8080

# WebSocket Base URL (STOMP over WebSocket)
# Development: ws://localhost:8080/ws
# Production:  wss://smart-bus-tracking-backend.onrender.com/ws
VITE_WS_BASE_URL=ws://localhost:8080/ws

# Mapbox Access Token (Optional - for advanced map tiles)
VITE_MAPBOX_TOKEN=
